---
import { type Locale, locales, defaultLocale } from "../i18n/locales";
import translator from "../i18n/translator";

const { translateUrl, translateUrlTo } = translator(Astro);

const localizedUrls = Object.fromEntries(
  Object.keys(locales).map((locale) => [
    locale,
    translateUrlTo(locale as Locale, Astro.routePattern),
  ]),
);
---

<noscript>
  <meta
    http-equiv="refresh"
    content={`0; url=${translateUrl(Astro.routePattern)}`}
  />
</noscript>

<script is:inline define:vars={{ defaultLocale, localizedUrls }}>
  var target = null;

  const saved = localStorage.getItem("lang");
  if (saved && localizedUrls[saved]) target = saved;

  if (!target) {
    const preferred =
      navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language || ""];

    preferred.some((language) => {
      const code = String(language).toLowerCase().split("-")[0];
      if (localizedUrls[code]) {
        target = code;
        return true;
      }
    });
  }

  location.replace(localizedUrls[target || defaultLocale] + location.search + location.hash);
</script>
